<%- include('../partials/header') %>

<div class="login-container">
    <div class="login-wrapper">
        <div class="row g-0 login-card-split">
            <!-- Left Side: Colourful Visual Showcase -->
            <div class="col-lg-6 login-visual-side d-none d-lg-flex">
                <div class="visual-overlay"></div>
                <div class="visual-content">
                    <div class="d-flex align-items-center gap-3">
                        <img src="/images/society-logo.jpg" alt="Mahabank Colony Logo" class="society-logo-img">
                        <div>
                            <span class="badge bg-emerald text-white px-2.5 py-1 text-uppercase fw-bold letter-spacing small">Smart Community</span>
                            <h4 class="text-white fw-bold mb-0">Mahabank Colony</h4>
                        </div>
                    </div>
                    <div class="mt-auto">
                        <h2 class="text-white fw-bold display-6 mb-2">Modern Living, Connected.</h2>
                        <p class="text-white-75 mb-4" style="font-size: 0.95rem;">Experience vibrant community living with integrated resident services, 24/7 security gates, and digital maintenance.</p>
                        
                        <div class="d-flex flex-wrap gap-2">
                            <div class="community-pill">
                                <i class="fa-solid fa-shield-halved text-warning"></i> 24x7 Security Gate
                            </div>
                            <div class="community-pill">
                                <i class="fa-solid fa-tree text-success"></i> Lush Greenery
                            </div>
                            <div class="community-pill">
                                <i class="fa-solid fa-water-ladder text-info"></i> Swimming & Club
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Interactive Login Form -->
            <div class="col-lg-6 bg-white d-flex flex-column justify-content-center p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                        <img src="/images/society-logo.jpg" alt="Logo" class="rounded-circle shadow-sm" style="width: 44px; height: 44px; object-fit: cover;">
                        <h4 class="fw-bold mb-0 text-dark">Mahabank Colony</h4>
                    </div>
                    <p class="small text-muted mb-0">Smart Society Management Portal</p>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show text-center py-2 mb-3" style="font-size: 0.875rem;" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show text-center py-2 mb-3" style="font-size: 0.875rem;" role="alert">
                        <i class="fa-solid fa-circle-check me-1"></i> <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <label class="form-label fw-semibold text-muted small mb-2 text-center d-block">SELECT YOUR USER ROLE</label>
                <div class="d-flex gap-2 mb-3">
                    <button type="button" class="role-tab-btn active" data-role="admin">
                        <i class="fa-solid fa-user-gear d-block mb-1 fs-5"></i> Admin
                    </button>
                    <button type="button" class="role-tab-btn" data-role="security">
                        <i class="fa-solid fa-shield-halved d-block mb-1 fs-5"></i> Security
                    </button>
                    <button type="button" class="role-tab-btn" data-role="resident">
                        <i class="fa-solid fa-house-user d-block mb-1 fs-5"></i> Resident
                    </button>
                </div>

                <form action="/login" method="POST">
                    <input type="hidden" name="role" id="roleInput" value="admin">

                    <div class="mb-3">
                        <label for="emailInput" class="form-label fw-semibold small">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                            <input type="email" name="email" id="emailInput" class="form-control border-start-0" placeholder="admin@society.com" value="admin@society.com" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="passwordInput" class="form-label fw-semibold small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input type="password" name="password" id="passwordInput" class="form-control border-start-0" placeholder="••••••••" value="admin123" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-emerald w-100 py-2.5 mb-3 fs-6 shadow-sm">
                        Sign In <i class="fa-solid fa-arrow-right-to-bracket ms-1"></i>
                    </button>

                    <div class="bg-light p-2.5 rounded-3 text-center border">
                        <div class="small fw-semibold text-muted mb-0"><i class="fa-solid fa-lightbulb me-1 text-warning"></i> Demo Quick Login: Click any role above!</div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

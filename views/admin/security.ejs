<%- include('../partials/header') %>
<div id="wrapper">
    <%- include('../partials/sidebar', { activePage: 'security' }) %>
    <div id="main-content">
        <%- include('../partials/navbar') %>

        <div class="content-body">
            <% if (typeof msg !== 'undefined' && msg) { %>
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="custom-card">
                <div class="card-header flex-column flex-md-row gap-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-user-shield me-2 text-primary"></i> Security Staff Management</h5>
                    <div class="d-flex align-items-center gap-2 w-100 w-md-auto">
                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" class="form-control" placeholder="Search security staff..." data-table-search="securityTable">
                        </div>
                        <button class="btn btn-emerald btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#addSecurityModal">
                            <i class="fa-solid fa-plus me-1"></i> Add Security Staff
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table-custom" id="securityTable">
                        <thead>
                            <tr>
                                <th>Badge No</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Shift</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (securityStaff && securityStaff.length > 0) { %>
                                <% securityStaff.forEach(s => { %>
                                    <tr>
                                        <td><span class="badge bg-dark text-white fw-bold"><%= s.badge_number %></span></td>
                                        <td class="fw-bold"><%= s.name %></td>
                                        <td><%= s.email %></td>
                                        <td><%= s.phone %></td>
                                        <td><span class="badge bg-info-subtle text-info fw-bold"><%= s.shift %></span></td>
                                        <td>
                                            <span class="badge-status <%= s.status === 'On Duty' || s.status === 'Active' ? 'inside' : 'left' %>">
                                                <%= s.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary btn-sm me-1 rounded" onclick="editSecurity(<%= JSON.stringify(s) %>)">
                                                    <i class="fa-solid fa-pen"></i> Edit
                                                </button>
                                                <form action="/admin/security/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Remove security personnel account?')" style="display:inline;">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="7" class="text-center py-4 text-muted">No security staff registered yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Security Modal -->
<div class="modal fade" id="addSecurityModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2"></i> Register Security Personnel</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/security/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Staff Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Rajesh Kumar" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Badge Number</label>
                            <input type="text" name="badge_number" class="form-control" placeholder="SEC-003" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Shift Duty</label>
                            <select name="shift" class="form-select">
                                <option value="Morning">Morning</option>
                                <option value="Evening">Evening</option>
                                <option value="Night">Night</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="security@society.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="Default: security123">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mobile Phone</label>
                        <input type="text" name="phone" class="form-control" placeholder="9876543210" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Security Modal -->
<div class="modal fade" id="editSecurityModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i> Edit Security Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="editSecurityForm" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Staff Name</label>
                        <input type="text" name="name" id="sec_name" class="form-control" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Badge Number</label>
                            <input type="text" name="badge_number" id="sec_badge" class="form-control" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Shift Duty</label>
                            <select name="shift" id="sec_shift" class="form-select">
                                <option value="Morning">Morning</option>
                                <option value="Evening">Evening</option>
                                <option value="Night">Night</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" name="email" id="sec_email" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password (Optional)</label>
                        <input type="password" name="password" class="form-control" placeholder="Leave blank to keep current">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="text" name="phone" id="sec_phone" class="form-control" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Duty Status</label>
                            <select name="status" id="sec_status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="On Duty">On Duty</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function editSecurity(s) {
    document.getElementById('editSecurityForm').action = '/admin/security/edit/' + s.id;
    document.getElementById('sec_name').value = s.name;
    document.getElementById('sec_badge').value = s.badge_number;
    document.getElementById('sec_shift').value = s.shift;
    document.getElementById('sec_email').value = s.email;
    document.getElementById('sec_phone').value = s.phone;
    document.getElementById('sec_status').value = s.status;
    new bootstrap.Modal(document.getElementById('editSecurityModal')).show();
}
</script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div id="wrapper">
    <%- include('../partials/sidebar', { activePage: 'residents' }) %>
    <div id="main-content">
        <%- include('../partials/navbar') %>

        <div class="content-body">
            <% if (typeof msg !== 'undefined' && msg) { %>
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="custom-card">
                <div class="card-header flex-column flex-md-row gap-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-users me-2 text-success"></i> Resident Directory</h5>
                    <div class="d-flex align-items-center gap-2 w-100 w-md-auto">
                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" class="form-control" placeholder="Search residents..." data-table-search="residentsTable">
                        </div>
                        <button class="btn btn-emerald btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#addResidentModal">
                            <i class="fa-solid fa-plus me-1"></i> Add Resident
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table-custom" id="residentsTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Flat No</th>
                                <th>Wing</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Occupation</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (residents && residents.length > 0) { %>
                                <% residents.forEach(r => { %>
                                    <tr>
                                        <td class="fw-bold"><%= r.name %></td>
                                        <td><span class="badge bg-light text-dark fs-6"><%= r.flat_number %></span></td>
                                        <td><%= r.wing %></td>
                                        <td><%= r.email %></td>
                                        <td><%= r.phone %></td>
                                        <td><%= r.occupation %></td>
                                        <td>
                                            <span class="badge-status <%= r.status === 'Active' ? 'inside' : 'left' %>">
                                                <%= r.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary btn-sm me-1 rounded" 
                                                        onclick="editResident(<%= JSON.stringify(r) %>)">
                                                    <i class="fa-solid fa-pen"></i> Edit
                                                </button>
                                                <form action="/admin/residents/delete/<%= r.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this resident account?')" style="display:inline;">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="8" class="text-center py-4 text-muted">No residents registered yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Resident Modal -->
<div class="modal fade" id="addResidentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2"></i> Add New Resident</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/residents/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Ramesh Shah" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Flat Number</label>
                            <input type="text" name="flat_number" class="form-control" placeholder="e.g. A-102" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Wing / Block</label>
                            <input type="text" name="wing" class="form-control" placeholder="e.g. A Wing" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="resident@email.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="Default: resident123">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="text" name="phone" class="form-control" placeholder="9876543210" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Occupation</label>
                            <input type="text" name="occupation" class="form-control" placeholder="e.g. Architect">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald">Save Resident</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Resident Modal -->
<div class="modal fade" id="editResidentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i> Edit Resident Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="editResidentForm" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" name="name" id="edit_name" class="form-control" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Flat Number</label>
                            <input type="text" name="flat_number" id="edit_flat_number" class="form-control" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Wing / Block</label>
                            <input type="text" name="wing" id="edit_wing" class="form-control" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" name="email" id="edit_email" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password (Optional)</label>
                        <input type="password" name="password" class="form-control" placeholder="Leave blank to keep current">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="text" name="phone" id="edit_phone" class="form-control" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="status" id="edit_status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function editResident(r) {
    document.getElementById('editResidentForm').action = '/admin/residents/edit/' + r.id;
    document.getElementById('edit_name').value = r.name;
    document.getElementById('edit_flat_number').value = r.flat_number;
    document.getElementById('edit_wing').value = r.wing;
    document.getElementById('edit_email').value = r.email;
    document.getElementById('edit_phone').value = r.phone;
    document.getElementById('edit_status').value = r.status;
    new bootstrap.Modal(document.getElementById('editResidentModal')).show();
}
</script>

<%- include('../partials/footer') %>

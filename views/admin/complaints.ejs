<%- include('../partials/header') %>
<div id="wrapper">
    <%- include('../partials/sidebar', { activePage: 'complaints' }) %>
    <div id="main-content">
        <%- include('../partials/navbar') %>

        <div class="content-body">
            <% if (typeof msg !== 'undefined' && msg) { %>
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="custom-card">
                <div class="card-header flex-column flex-md-row gap-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-headset me-2 text-danger"></i> Society Complaints & Service Desk</h5>
                    <div class="input-group input-group-sm" style="max-width: 300px;">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" class="form-control" placeholder="Filter complaints..." data-table-search="complaintsTable">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table-custom" id="complaintsTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Flat</th>
                                <th>Resident</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Admin Remarks</th>
                                <th>Update</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (complaints && complaints.length > 0) { %>
                                <% complaints.forEach(c => { %>
                                    <tr>
                                        <td><%= new Date(c.created_at).toLocaleDateString() %></td>
                                        <td class="fw-bold"><%= c.flat_number %></td>
                                        <td><%= c.resident_name %></td>
                                        <td style="max-width: 200px;">
                                            <div class="fw-semibold"><%= c.title %></div>
                                            <small class="text-muted text-truncate d-block"><%= c.description %></small>
                                        </td>
                                        <td><span class="badge bg-light text-dark"><%= c.category %></span></td>
                                        <td>
                                            <span class="badge bg-<%= c.priority === 'Urgent' ? 'danger' : c.priority === 'High' ? 'warning' : 'info' %>">
                                                <%= c.priority %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge-status <%= c.status.toLowerCase().replace(' ', '-') %>">
                                                <%= c.status %>
                                            </span>
                                        </td>
                                        <td><small class="text-muted"><%= c.admin_remarks || 'None' %></small></td>
                                        <td>
                                            <button class="btn btn-outline-primary btn-sm" onclick="openStatusModal(<%= JSON.stringify(c) %>)">
                                                <i class="fa-solid fa-sliders me-1"></i> Update
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="9" class="text-center py-4 text-muted">No complaints submitted yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-square-pen me-2"></i> Update Complaint Status</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="updateStatusForm" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Complaint Title</label>
                        <input type="text" id="c_title" class="form-control" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Complaint Status</label>
                        <select name="status" id="c_status" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Admin Remarks / Action Taken</label>
                        <textarea name="admin_remarks" id="c_remarks" class="form-control" rows="3" placeholder="e.g. Plumber scheduled for 4 PM..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openStatusModal(c) {
    document.getElementById('updateStatusForm').action = '/admin/complaints/status/' + c.id;
    document.getElementById('c_title').value = c.title;
    document.getElementById('c_status').value = c.status;
    document.getElementById('c_remarks').value = c.admin_remarks || '';
    new bootstrap.Modal(document.getElementById('updateStatusModal')).show();
}
</script>

<%- include('../partials/footer') %>

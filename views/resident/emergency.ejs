<%- include('../partials/header') %>
<div id="wrapper">
    <%- include('../partials/sidebar', { activePage: 'emergency' }) %>
    <div id="main-content">
        <%- include('../partials/navbar') %>

        <div class="content-body">
            <div class="custom-card">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-truck-medical me-2 text-danger"></i> Emergency Contacts Directory</h5>
                </div>

                <div class="p-4">
                    <div class="row g-4">
                        <% if (contacts && contacts.length > 0) { %>
                            <% contacts.forEach(c => { %>
                                <div class="col-md-6 col-lg-4">
                                    <div class="p-3 border rounded-3 bg-white shadow-sm h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-<%= c.category === 'Medical' ? 'danger' : c.category === 'Security' ? 'primary' : 'warning' %> text-white">
                                                <%= c.category %>
                                            </span>
                                            <i class="fa-solid fa-phone-volume text-success fs-5"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1"><%= c.name %></h5>
                                        <p class="small text-muted mb-2"><%= c.designation %></p>
                                        <a href="tel:<%= c.phone %>" class="btn btn-outline-success btn-sm w-100 fw-bold">
                                            <i class="fa-solid fa-phone me-1"></i> Call: <%= c.phone %>
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center py-4 text-muted">No emergency contacts listed.</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div id="wrapper">
    <%- include('../partials/sidebar', { activePage: 'emergency' }) %>
    <div id="main-content">
        <%- include('../partials/navbar') %>

        <div class="content-body">
            <!-- Emergency Visual Banner with Colourful Picture -->
            <div class="card border-0 text-white p-4 mb-4 rounded-4 shadow-sm position-relative overflow-hidden society-hero-banner"
                 style="background: linear-gradient(135deg, rgba(185, 28, 28, 0.90) 0%, rgba(15, 23, 42, 0.88) 100%), url('/images/society-banner.jpg') center/cover no-repeat;">
                <div class="position-relative z-1 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <span class="badge bg-danger text-white fw-bold px-3 py-1 rounded-pill mb-2 shadow-sm"><i class="fa-solid fa-truck-medical me-1"></i> 24/7 Rapid Help</span>
                        <h3 class="fw-bold mb-1">Emergency Contacts Directory</h3>
                        <p class="mb-0 text-white-75 small">Instant emergency helplines for police, medical, society security desk, and utility services</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="tel:100" class="btn btn-light btn-sm fw-bold text-danger px-3 py-2 shadow-sm"><i class="fa-solid fa-shield-halved me-1"></i> Police: 100</a>
                        <a href="tel:108" class="btn btn-light btn-sm fw-bold text-danger px-3 py-2 shadow-sm"><i class="fa-solid fa-heart-pulse me-1"></i> Ambulance: 108</a>
                    </div>
                </div>
            </div>

            <div class="custom-card">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-truck-medical me-2 text-danger"></i> Emergency Contacts Directory</h5>
                </div>

                <div class="p-4">
                    <div class="row g-4">
                        <% if (contacts && contacts.length > 0) { %>
                            <% contacts.forEach(c => { %>
                                <div class="col-md-6 col-lg-4">
                                    <div class="p-3 border rounded-3 bg-white shadow-sm h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-<%= c.category === 'Medical' ? 'danger' : c.category === 'Security' ? 'primary' : 'warning' %> text-white">
                                                <%= c.category %>
                                            </span>
                                            <i class="fa-solid fa-phone-volume text-success fs-5"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1"><%= c.name %></h5>
                                        <p class="small text-muted mb-2"><%= c.designation %></p>
                                        <a href="tel:<%= c.phone %>" class="btn btn-outline-success btn-sm w-100 fw-bold">
                                            <i class="fa-solid fa-phone me-1"></i> Call: <%= c.phone %>
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center py-4 text-muted">No emergency contacts listed.</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>

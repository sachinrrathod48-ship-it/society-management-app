<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maintenance Receipt - Mahabank Colony</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .receipt-container { max-width: 600px; margin: 40px auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .receipt-header { border-bottom: 2px solid #2e7d32; padding-bottom: 15px; margin-bottom: 20px; text-align: center; }
        .receipt-header h2 { color: #2e7d32; margin-bottom: 5px; font-weight: 700; }
        .receipt-details { margin-bottom: 20px; }
        .receipt-table th { width: 40%; color: #6c757d; }
        .receipt-table td { font-weight: 600; }
        .print-btn { margin-top: 20px; }
        @media print {
            body { background: white; }
            .receipt-container { box-shadow: none; margin: 0; padding: 0; }
            .print-btn { display: none; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="receipt-container">
            <div class="receipt-header">
                <h2>Mahabank Colony</h2>
                <p class="mb-0 text-muted">Maintenance Payment Receipt</p>
            </div>
            
            <div class="receipt-details table-responsive">
                <table class="table table-borderless receipt-table">
                    <tbody>
                        <tr>
                            <th>Receipt No:</th>
                            <td>#REC-<%= bill.id %></td>
                        </tr>
                        <tr>
                            <th>Resident Name:</th>
                            <td><%= user.name %></td>
                        </tr>
                        <tr>
                            <th>Flat Number:</th>
                            <td><%= bill.flat_number %></td>
                        </tr>
                        <tr>
                            <th>Billing Month:</th>
                            <td><%= bill.month_year %></td>
                        </tr>
                        <tr>
                            <th>Amount Paid:</th>
                            <td class="text-success fs-5">₹<%= parseFloat(bill.amount).toFixed(2) %></td>
                        </tr>
                        <tr>
                            <th>Payment Date:</th>
                            <td><%= new Date(bill.payment_date).toLocaleDateString() %></td>
                        </tr>
                        <tr>
                            <th>Payment Method:</th>
                            <td><%= bill.payment_method %></td>
                        </tr>
                        <tr>
                            <th>Status:</th>
                            <td><span class="badge bg-success">PAID</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="text-center text-muted small mt-4 border-top pt-3">
                <p class="mb-1">This is an auto-generated receipt.</p>
                <p class="mb-0">&copy; <%= new Date().getFullYear() %> Mahabank Colony Management</p>
            </div>

            <div class="text-center print-btn">
                <button class="btn btn-outline-success" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> Print / Save as PDF
                </button>
                <a href="/resident/maintenance" class="btn btn-link text-decoration-none ms-2">Back</a>
            </div>
        </div>
    </div>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</body>
</html>

<%- include('../partials/header') %>
<div id="wrapper">
    <%- include('../partials/sidebar', { activePage: 'visitors' }) %>
    <div id="main-content">
        <%- include('../partials/navbar') %>

        <div class="content-body">
            <% if (typeof msg !== 'undefined' && msg) { %>
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="row g-4">
                <!-- Visitor Registration Form Column -->
                <div class="col-lg-4">
                    <div class="custom-card p-4">
                        <h5 class="fw-bold mb-3"><i class="fa-solid fa-id-card me-2 text-success"></i> New Visitor Check-In</h5>
                        
                        <form action="/security/visitors/add" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Visitor Name</label>
                                <input type="text" name="visitor_name" class="form-control" placeholder="Full name" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Mobile Number</label>
                                <input type="text" name="mobile_number" class="form-control" placeholder="10-digit mobile number" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Visiting Flat</label>
                                <select name="flat_number" id="flatSelect" class="form-select" required onchange="updateResidentName(this)">
                                    <option value="">-- Select Flat --</option>
                                    <% if (residents) { %>
                                        <% residents.forEach(r => { %>
                                            <option value="<%= r.flat_number %>" data-resident="<%= r.name %>">
                                                <%= r.flat_number %> (<%= r.name %>)
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Resident Name</label>
                                <input type="text" name="resident_name" id="residentNameInput" class="form-control" placeholder="Resident name" required>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Purpose of Visit</label>
                                <input type="text" name="purpose" class="form-control" placeholder="e.g. Delivery / Guest / Plumber" required>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Visitor Photo</label>
                                <div class="d-flex flex-column align-items-center bg-light p-2 rounded border">
                                    <video id="camera-stream-sec" width="100%" autoplay playsinline style="max-width: 320px; border-radius: 8px;"></video>
                                    <canvas id="camera-canvas-sec" style="display:none;"></canvas>
                                    <img id="photo-preview-sec" style="display:none; max-width: 320px; border-radius: 8px; margin-top: 10px;" />
                                    <input type="hidden" name="photo_data" id="photo_data_sec">
                                    
                                    <div class="mt-2">
                                        <button type="button" class="btn btn-sm btn-primary" id="btn-start-camera-sec">
                                            <i class="fa-solid fa-camera"></i> Start Camera
                                        </button>
                                        <button type="button" class="btn btn-sm btn-success" id="btn-capture-sec" style="display:none;">
                                            <i class="fa-solid fa-camera-retro"></i> Capture
                                        </button>
                                        <button type="button" class="btn btn-sm btn-secondary" id="btn-retake-sec" style="display:none;">
                                            <i class="fa-solid fa-rotate-left"></i> Retake
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-emerald w-100 py-2">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Record Gate Entry
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Active Visitors Inside Column -->
                <div class="col-lg-8">
                    <div class="custom-card">
                        <div class="card-header">
                            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-person-shelter me-2 text-primary"></i> Currently Inside Society</h5>
                            <div class="input-group input-group-sm" style="max-width: 250px;">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text" class="form-control" placeholder="Search..." data-table-search="insideVisitorsTable">
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table-custom" id="insideVisitorsTable">
                                <thead>
                                    <tr>
                                        <th>Visitor</th>
                                        <th>Mobile</th>
                                        <th>Flat</th>
                                        <th>Resident</th>
                                        <th>Entry Time</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (currentlyInside && currentlyInside.length > 0) { %>
                                        <% currentlyInside.forEach(v => { %>
                                            <tr>
                                                <td class="fw-bold">
                                                    <% if (v.photo_data) { %>
                                                        <img src="<%= v.photo_data %>" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;">
                                                    <% } else { %>
                                                        <i class="fa-solid fa-user-circle text-muted fs-4 align-middle me-2"></i>
                                                    <% } %>
                                                    <%= v.visitor_name %>
                                                </td>
                                                <td><%= v.mobile_number %></td>
                                                <td><span class="badge bg-light text-dark"><%= v.flat_number %></span></td>
                                                <td><%= v.resident_name %></td>
                                                <td class="text-success fw-semibold"><i class="fa-regular fa-clock me-1"></i><%= v.entry_time %></td>
                                                <td>
                                                    <form action="/security/visitors/exit/<%= v.id %>" method="POST">
                                                        <button type="submit" class="btn btn-warning btn-sm fw-bold">
                                                            <i class="fa-solid fa-right-from-bracket me-1"></i> Mark Exit
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="6" class="text-center py-4 text-muted">No visitors currently inside campus.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function updateResidentName(select) {
    const selectedOption = select.options[select.selectedIndex];
    const residentName = selectedOption.getAttribute('data-resident');
    if (residentName) {
        document.getElementById('residentNameInput').value = residentName;
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const video = document.getElementById('camera-stream-sec');
    const canvas = document.getElementById('camera-canvas-sec');
    const photoPreview = document.getElementById('photo-preview-sec');
    const photoData = document.getElementById('photo_data_sec');
    
    const btnStart = document.getElementById('btn-start-camera-sec');
    const btnCapture = document.getElementById('btn-capture-sec');
    const btnRetake = document.getElementById('btn-retake-sec');
    
    let stream = null;

    btnStart.addEventListener('click', async () => {
        try {
            stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
            video.srcObject = stream;
            video.style.display = 'block';
            photoPreview.style.display = 'none';
            btnStart.style.display = 'none';
            btnCapture.style.display = 'inline-block';
            btnRetake.style.display = 'none';
        } catch (err) {
            console.error('Error accessing camera:', err);
            alert('Camera access denied or not available.');
        }
    });

    btnCapture.addEventListener('click', () => {
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        const context = canvas.getContext('2d');
        context.drawImage(video, 0, 0, canvas.width, canvas.height);
        
        const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
        photoData.value = dataUrl;
        photoPreview.src = dataUrl;
        
        video.style.display = 'none';
        photoPreview.style.display = 'block';
        btnCapture.style.display = 'none';
        btnRetake.style.display = 'inline-block';
        
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
        }
    });

    btnRetake.addEventListener('click', () => {
        photoData.value = '';
        btnStart.click();
    });
});
</script>

<%- include('../partials/footer') %>
